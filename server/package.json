{
  "name": "@fabrika/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --external:ws --outfile=dist/index.js",
    "start": "node --env-file-if-exists=../.env --no-warnings=ExperimentalWarning dist/index.js"
  },
  "dependencies": {
    "@fabrika/shared": "*",
    "@typesafe-ai/sdk": "^0.6.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.13",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2"
  }
}
