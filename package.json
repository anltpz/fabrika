{
  "name": "fabrika",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm -w @fabrika/server run dev",
    "dev:client": "npm -w @fabrika/client run dev",
    "build": "npm -w @fabrika/client run build && npm -w @fabrika/server run build",
    "start": "npm -w @fabrika/server run start",
    "test": "vitest run",
    "typecheck": "tsc -p shared --noEmit && tsc -p server --noEmit && tsc -p client --noEmit && tsc -p scripts --noEmit",
    "stres": "tsx scripts/stres-bot.ts"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2"
  }
}
